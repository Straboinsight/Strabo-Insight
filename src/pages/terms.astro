---
import terms from '../../content/legal/terms-of-service.md?raw';
import Layout from '../layouts/Layout.astro';
import { renderLegalMarkdown } from '../lib/legal-markdown';

const { effectiveDate, html } = await renderLegalMarkdown(terms);
---

<Layout
  title="Terms of Service"
  description="Terms for using straboinsight.com and the Strabo Signal newsletter."
  effectiveDate={effectiveDate}
  body={html}
/>
